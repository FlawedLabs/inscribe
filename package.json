{
	"name": "inscribe",
	"version": "0.0.0",
	"description": "",
	"type": "module",
	"packageManager": "pnpm@11.0.9",
	"engines": {
		"node": ">=22.17.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "node scripts/prepare-static-assets.mjs && vite dev",
		"build": "node scripts/prepare-static-assets.mjs && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:integration": "playwright test",
		"test:unit": "vitest",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"tauri": "tauri"
	},
	"license": "MIT",
	"dependencies": {
		"@fontsource/mulish": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.48.0",
		"@shopify/draggable": "^1.2.1",
		"@tauri-apps/api": "2.11.1",
		"@tauri-apps/plugin-shell": "2.3.6",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^6.3.289",
		"svelte-inview": "^4.0.4",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tesseract.js": "^7.0.0",
		"tesseract.js-core": "^7.0.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "4.0.0-next.4",
		"@sveltejs/kit": "3.0.0-next.29",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "2.11.5",
		"@types/node": "^26.6.2",
		"internal-ip": "^9.0.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	}
